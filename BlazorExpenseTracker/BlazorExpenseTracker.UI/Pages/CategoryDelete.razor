@page "/CategoryDelete/{id:int}"
@inject ICategoryService CategoryService
@inject NavigationManager NavigationManager

@* <h3>vamos a usar el mismo formulario que realizamos en CategoryDetails</h3> *@
@*<h3>CategoryDelete</h3>*@

<div class="modal" tabindex="-1" style="display: block; " role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1>CategoryDelete</h1>
            </div>
            <div class="modal-body">
                <EditForm Model="@category" OnValidSubmit="DeleteCategory">
                    <DataAnnotationsValidator />
                    @*<ValidationSummary />*@

                    @*tabla agregar elementos de categorias*@
                    <table class="table" style="border: none">
                        <tr>
                            <td>Name</td>
                            <td><input type="text" @bind="category.Name" /></td>
                        </tr>
                        <tr>
                            <td colspan="2"><ValidationMessage For="@(() => category.Name)"></ValidationMessage></td>
                        </tr>
                        <tr>
                            <td colspan="2" style="text-align: center">
                                <input type="submit" value="Delete" />
                                <input type="button" value="Cancel" @onclick="Cancel" />
                            </td>
                        </tr>
                    </table>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int id { get; set; }

    Category category = new Category();

    public void NavigateToCategories()
    {
        NavigationManager.NavigateTo("/Categories");
    }

    protected async Task DeleteCategory()
    {
        await CategoryService.DelateCategories(id);
        NavigateToCategories();
    }

    public void Cancel()
    {
        NavigateToCategories();
    }

    //vamos a cargar los elementos que se pueden eliminar
    protected async override Task OnInitializedAsync()
    {
        //return base.OnInitializedAsync();
        if (id > 0)
        {
            category = await CategoryService.GetCategoryDetails(id);
        }
    }
}